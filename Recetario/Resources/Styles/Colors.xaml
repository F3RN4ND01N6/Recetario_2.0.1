<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta Orgánica: Verde Salvia (#758B68), Crema Cálido (#F7F4EA), Terracota (#C8785A) y Verde Oscuro (#283B2D) -->
    <Color x:Key="PastelBackground">#F7F4EA</Color>
    <Color x:Key="PastelSurface">#FFFFFF</Color>
    <Color x:Key="PastelSurfaceSoft">#ECE8DC</Color>
    <Color x:Key="PastelBorder">#D8D3C4</Color>

    <!-- Primario: Verde Salvia (Acciones y botones) -->
    <Color x:Key="Primary">#758B68</Color>
    <Color x:Key="PrimaryDark">#5D7052</Color>
    <Color x:Key="PrimarySoft">#E8EDE4</Color>
    <Color x:Key="PrimaryDarkText">#283B2D</Color>

    <!-- Secundario / Acento: Terracota (Favoritos y detalles) -->
    <Color x:Key="Secondary">#C8785A</Color>
    <Color x:Key="SecondarySoft">#F5E5DF</Color>
    <Color x:Key="SecondaryDarkText">#283B2D</Color>

    <!-- Terciario: Terracota y matices suaves -->
    <Color x:Key="Tertiary">#C8785A</Color>
    <Color x:Key="TertiaryDark">#A85E42</Color>
    <Color x:Key="TertiarySoft">#F5E5DF</Color>

    <!-- Tipografía Verde Oscuro (#283B2D) y Gris Palidito para Placeholders (#A3ACA4) -->
    <Color x:Key="TextPrimary">#283B2D</Color>
    <Color x:Key="TextSecondary">#5A6B5C</Color>
    <Color x:Key="TextMuted">#A3ACA4</Color>

    <!-- Colores base requeridos por plantilla MAUI -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#283B2D</Color>
    <Color x:Key="Magenta">#C8785A</Color>
    <Color x:Key="MidnightBlue">#283B2D</Color>
    <Color x:Key="OffBlack">#1B281E</Color>

    <Color x:Key="Gray100">#F7F4EA</Color>
    <Color x:Key="Gray200">#E8E4D8</Color>
    <Color x:Key="Gray300">#D8D3C4</Color>
    <Color x:Key="Gray400">#A3ACA4</Color>
    <Color x:Key="Gray500">#5A6B5C</Color>
    <Color x:Key="Gray600">#435446</Color>
    <Color x:Key="Gray900">#283B2D</Color>
    <Color x:Key="Gray950">#1B281E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
